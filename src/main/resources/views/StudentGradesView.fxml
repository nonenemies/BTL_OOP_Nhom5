<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane minHeight="600.0" minWidth="800.0" prefHeight="720.0" prefWidth="1100.0"
            styleClass="dashboard-page" stylesheets="@../css/app.css"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controllers.StudentGradesController">
    <center>
        <VBox spacing="14.0" styleClass="grades-content">
            <padding><Insets bottom="24.0" left="28.0" right="28.0" top="18.0" /></padding>
            <HBox alignment="CENTER_LEFT" spacing="12.0">
                <VBox spacing="4.0">
                    <Label styleClass="registration-eyebrow" text="KẾT QUẢ HỌC TẬP" />
                    <Label styleClass="registration-title" text="Điểm tổng kết" />
                    <Label styleClass="registration-subtitle"
                           text="Tra cứu điểm theo từng học kỳ và theo dõi điểm trung bình, tín chỉ tích lũy."
                           wrapText="true" />
                </VBox>
                <HBox HBox.hgrow="ALWAYS" />
                <Button fx:id="btnRefresh" onAction="#onRefresh"
                        styleClass="registration-refresh-button" text="Tải lại" />
            </HBox>
            <Label fx:id="lblStatus" managed="false" visible="false"
                   styleClass="teacher-status-info" wrapText="true" />
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS">
                <content>
                    <VBox fx:id="semesterResults" spacing="14.0">
                        <padding><Insets bottom="8.0" top="2.0" /></padding>
                    </VBox>
                </content>
            </ScrollPane>
        </VBox>
    </center>
</BorderPane>
