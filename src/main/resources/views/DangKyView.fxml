<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>

<!-- Kết nối với file Controller bên Java -->
<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/21.0.13" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.DangKyController">
    <Label text="CHÀO MỪNG ĐẾN VỚI HỆ THỐNG ĐĂNG KÝ" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
    <!-- Nút bấm, khi click sẽ gọi hàm onBtnTestClick -->
    <Button text="Bấm thử tao đi" onAction="#onBtnTestClick" styleClass="accent"/>
</VBox>