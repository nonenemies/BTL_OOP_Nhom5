<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12.0" styleClass="dashboard-content"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Controllers.AdminController">
    <padding><Insets bottom="22.0" left="28.0" right="28.0" top="18.0" /></padding>
    <HBox alignment="CENTER_LEFT" spacing="12.0">
        <Label text="Quản trị hệ thống" styleClass="section-title" />
        <HBox HBox.hgrow="ALWAYS" />
        <Button onAction="#onRefresh" text="Tải lại dữ liệu" />
    </HBox>
    <Label fx:id="lblStatus" wrapText="true" />
    <TabPane fx:id="adminTabs" VBox.vgrow="ALWAYS" tabClosingPolicy="UNAVAILABLE">
        <tabs>
            <Tab text="Sinh viên &amp; giảng viên">
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="ALWAYS">
                <content>
                <VBox spacing="10.0">
                    <padding><Insets bottom="12.0" left="10.0" right="10.0" top="10.0" /></padding>
                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <TextField fx:id="txtAccountSearch" promptText="Tìm mã, họ tên, email, khoa..." HBox.hgrow="ALWAYS" />
                        <ComboBox fx:id="cmbAccountRole" promptText="Vai trò" prefWidth="160.0" />
                    </HBox>
                    <TableView fx:id="tblAccounts" prefHeight="220.0" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colUserId" text="ID" prefWidth="48.0" />
                            <TableColumn fx:id="colUserCode" text="Mã" prefWidth="100.0" />
                            <TableColumn fx:id="colUserName" text="Họ tên" prefWidth="155.0" />
                            <TableColumn fx:id="colUserEmail" text="Email" prefWidth="170.0" />
                            <TableColumn fx:id="colUserRole" text="Vai trò" prefWidth="90.0" />
                            <TableColumn fx:id="colUserFaculty" text="Khoa" prefWidth="110.0" />
                            <TableColumn fx:id="colUserStatus" text="Trạng thái" prefWidth="120.0" />
                        </columns>
                    </TableView>
                    <GridPane hgap="10.0" vgap="8.0">
                        <columnConstraints>
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0" />
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0" />
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0" />
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0" />
                        </columnConstraints>
                        <TextField fx:id="txtUserCode" promptText="Mã sinh viên/giảng viên" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                        <TextField fx:id="txtUserName" promptText="Họ và tên" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                        <TextField fx:id="txtUserEmail" promptText="Email" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                        <TextField fx:id="txtUserPassword" promptText="Mật khẩu (bỏ trống khi sửa)" GridPane.columnIndex="3" GridPane.rowIndex="0" />
                        <TextField fx:id="txtUserFaculty" promptText="Khoa" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                        <TextField fx:id="txtStudentClass" promptText="Lớp sinh viên" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                        <TextField fx:id="txtStudentCohort" promptText="Khóa học (năm)" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                        <TextField fx:id="txtStudentDegree" promptText="Hệ đào tạo" GridPane.columnIndex="3" GridPane.rowIndex="1" />
                        <DatePicker fx:id="dpStudentBirthDate" promptText="Ngày sinh" maxWidth="Infinity" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                        <ComboBox fx:id="cmbStudentGender" promptText="Giới tính" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                        <TextField fx:id="txtLecturerSpecialty" promptText="Chuyên ngành giảng viên" GridPane.columnIndex="2" GridPane.rowIndex="2" />
                        <TextField fx:id="txtLecturerDegree" promptText="Học vị giảng viên" GridPane.columnIndex="3" GridPane.rowIndex="2" />
                        <ComboBox fx:id="cmbUserStatus" promptText="Trạng thái" maxWidth="Infinity" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                    </GridPane>
                    <HBox alignment="CENTER_RIGHT" spacing="8.0">
                        <Button onAction="#onClearAccountForm" text="Làm mới biểu mẫu" />
                        <Button onAction="#onDeactivateAccount" text="Ngừng tài khoản" />
                        <Button onAction="#onSaveAccount" styleClass="primary-button" text="Lưu tài khoản" />
                    </HBox>
                </VBox>
                </content>
                </ScrollPane>
            </Tab>
            <Tab text="Môn học &amp; tiên quyết">
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="ALWAYS">
                <content>
                <VBox spacing="10.0">
                    <padding><Insets bottom="12.0" left="10.0" right="10.0" top="10.0" /></padding>
                    <TextField fx:id="txtCourseSearch" promptText="Tìm mã môn, tên môn, loại môn..." />
                    <TableView fx:id="tblCourses" prefHeight="190.0" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colCourseCode" text="Mã môn" prefWidth="105.0" />
                            <TableColumn fx:id="colCourseName" text="Tên môn" prefWidth="245.0" />
                            <TableColumn fx:id="colCourseCredits" text="Tín chỉ" prefWidth="75.0" />
                            <TableColumn fx:id="colCourseType" text="Loại" prefWidth="110.0" />
                            <TableColumn fx:id="colCourseStatus" text="Trạng thái" prefWidth="130.0" />
                        </columns>
                    </TableView>
                    <GridPane hgap="10.0" vgap="8.0">
                        <columnConstraints>
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="20.0" />
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="30.0" />
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="15.0" />
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="20.0" />
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="15.0" />
                        </columnConstraints>
                        <TextField fx:id="txtCourseCode" promptText="Mã môn" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                        <TextField fx:id="txtCourseName" promptText="Tên môn học" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                        <TextField fx:id="txtCourseCredits" promptText="Số tín chỉ" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                        <TextField fx:id="txtCourseType" promptText="Loại môn" GridPane.columnIndex="3" GridPane.rowIndex="0" />
                        <TextArea fx:id="txtCourseDescription" promptText="Mô tả" prefRowCount="2" wrapText="true" GridPane.columnIndex="4" GridPane.rowIndex="0" />
                    </GridPane>
                    <HBox alignment="CENTER_RIGHT" spacing="8.0">
                        <Button onAction="#onClearCourseForm" text="Làm mới" />
                        <Button onAction="#onDeactivateCourse" text="Ngừng môn" />
                        <Button onAction="#onSaveCourse" styleClass="primary-button" text="Lưu môn học" />
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                        <Label text="Môn tiên quyết:" />
                        <ComboBox fx:id="cmbPrerequisite" promptText="Chọn môn tiên quyết" HBox.hgrow="ALWAYS" />
                        <Button onAction="#onAddPrerequisite" text="Thêm" />
                        <Button onAction="#onRemovePrerequisite" text="Gỡ môn đã chọn" />
                    </HBox>
                    <TableView fx:id="tblPrerequisites" prefHeight="105.0">
                        <columns>
                            <TableColumn fx:id="colPrerequisiteCode" text="Mã môn tiên quyết" prefWidth="180.0" />
                            <TableColumn fx:id="colPrerequisiteName" text="Tên môn tiên quyết" prefWidth="350.0" />
                        </columns>
                    </TableView>
                </VBox>
                </content>
                </ScrollPane>
            </Tab>
            <Tab text="Lớp học phần">
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="ALWAYS">
                <content>
                <VBox spacing="10.0">
                    <padding><Insets bottom="12.0" left="10.0" right="10.0" top="10.0" /></padding>
                    <TextField fx:id="txtClassSearch" promptText="Tìm mã lớp, môn, giảng viên, học kỳ..." />
                    <TableView fx:id="tblClasses" prefHeight="270.0" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colClassCode" text="Mã lớp" prefWidth="115.0" />
                            <TableColumn fx:id="colClassCourse" text="Mã môn" prefWidth="115.0" />
                            <TableColumn fx:id="colClassLecturer" text="Mã giảng viên" prefWidth="135.0" />
                            <TableColumn fx:id="colClassSemester" text="Học kỳ" prefWidth="120.0" />
                            <TableColumn fx:id="colClassCapacity" text="Sĩ số" prefWidth="105.0" />
                            <TableColumn fx:id="colClassStatus" text="Trạng thái" prefWidth="130.0" />
                        </columns>
                    </TableView>
                    <GridPane hgap="10.0" vgap="8.0">
                        <columnConstraints>
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="20.0" />
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="30.0" />
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="30.0" />
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="20.0" />
                        </columnConstraints>
                        <TextField fx:id="txtClassCode" promptText="Mã lớp học phần" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                        <ComboBox fx:id="cmbClassCourse" promptText="Môn học" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                        <ComboBox fx:id="cmbClassLecturer" promptText="Giảng viên phụ trách" maxWidth="Infinity" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                        <TextField fx:id="txtClassSemester" promptText="Học kỳ" GridPane.columnIndex="3" GridPane.rowIndex="0" />
                        <TextField fx:id="txtClassCapacity" promptText="Sĩ số tối đa" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                    </GridPane>
                    <HBox alignment="CENTER_RIGHT" spacing="8.0">
                        <Button onAction="#onClearClassForm" text="Làm mới" />
                        <Button onAction="#onDeactivateClass" text="Ngừng lớp" />
                        <Button onAction="#onSaveClass" styleClass="primary-button" text="Lưu lớp học phần" />
                    </HBox>
                </VBox>
                </content>
                </ScrollPane>
            </Tab>
            <Tab text="Lịch học">
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="ALWAYS">
                <content>
                <VBox spacing="10.0">
                    <padding><Insets bottom="14.0" left="12.0" right="12.0" top="12.0" /></padding>
                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <Label text="Lớp học phần:" />
                        <ComboBox fx:id="cmbScheduleClass" promptText="Chọn lớp" maxWidth="Infinity"
                                  HBox.hgrow="ALWAYS" />
                        <Button onAction="#onRefreshSchedules" text="Tải lịch" />
                    </HBox>
                    <TableView fx:id="tblSchedules" prefHeight="270.0" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colScheduleDay" text="Thứ" prefWidth="90.0" />
                            <TableColumn fx:id="colScheduleStart" text="Bắt đầu" prefWidth="130.0" />
                            <TableColumn fx:id="colScheduleEnd" text="Kết thúc" prefWidth="130.0" />
                            <TableColumn fx:id="colScheduleRoom" text="Phòng học" prefWidth="220.0" />
                        </columns>
                    </TableView>
                    <GridPane hgap="10.0" vgap="8.0">
                        <columnConstraints>
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="20.0" />
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0" />
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0" />
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="30.0" />
                        </columnConstraints>
                        <TextField fx:id="txtScheduleDay" promptText="Thứ (2–8)"
                                   GridPane.columnIndex="0" GridPane.rowIndex="0" />
                        <TextField fx:id="txtScheduleStart" promptText="Bắt đầu (HH:mm)"
                                   GridPane.columnIndex="1" GridPane.rowIndex="0" />
                        <TextField fx:id="txtScheduleEnd" promptText="Kết thúc (HH:mm)"
                                   GridPane.columnIndex="2" GridPane.rowIndex="0" />
                        <TextField fx:id="txtScheduleRoom" promptText="Phòng học"
                                   GridPane.columnIndex="3" GridPane.rowIndex="0" />
                    </GridPane>
                    <HBox alignment="CENTER_RIGHT" spacing="8.0">
                        <Button onAction="#onClearScheduleForm" text="Làm mới" />
                        <Button onAction="#onDeleteSchedule" text="Xóa lịch chọn" />
                        <Button onAction="#onSaveSchedule" styleClass="primary-button" text="Lưu lịch học" />
                    </HBox>
                </VBox>
                </content>
                </ScrollPane>
            </Tab>
            <Tab text="Thành phần đánh giá">
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="ALWAYS">
                <content>
                <VBox spacing="10.0">
                    <padding><Insets bottom="12.0" left="10.0" right="10.0" top="10.0" /></padding>
                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <Label text="Môn học:" />
                        <ComboBox fx:id="cmbComponentCourse" promptText="Chọn môn học" HBox.hgrow="ALWAYS" />
                    </HBox>
                    <TableView fx:id="tblComponents" prefHeight="300.0" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colComponentOrder" text="Thứ tự" prefWidth="90.0" />
                            <TableColumn fx:id="colComponentName" text="Thành phần đánh giá" prefWidth="300.0" />
                            <TableColumn fx:id="colComponentWeight" text="Trọng số" prefWidth="120.0" />
                            <TableColumn fx:id="colComponentActive" text="Đang dùng" prefWidth="120.0" />
                        </columns>
                    </TableView>
                    <GridPane hgap="10.0" vgap="8.0">
                        <columnConstraints>
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0" />
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="20.0" />
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="15.0" />
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="15.0" />
                        </columnConstraints>
                        <TextField fx:id="txtComponentName" promptText="Tên thành phần" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                        <TextField fx:id="txtComponentWeight" promptText="Trọng số (0-1)" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                        <TextField fx:id="txtComponentOrder" promptText="Thứ tự" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                        <CheckBox fx:id="chkComponentActive" text="Đang hoạt động" GridPane.columnIndex="3" GridPane.rowIndex="0" />
                    </GridPane>
                    <HBox alignment="CENTER_RIGHT" spacing="8.0">
                        <Button onAction="#onClearComponentForm" text="Làm mới" />
                        <Button onAction="#onAddComponent" text="Thêm thành phần mới" />
                        <Button onAction="#onApplyComponentEdit" text="Áp dụng sửa" />
                        <Button onAction="#onSaveComponents" styleClass="primary-button" text="Lưu cấu hình" />
                    </HBox>
                </VBox>
                </content>
                </ScrollPane>
            </Tab>
            <Tab text="Mốc điểm">
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="ALWAYS">
                <content>
                <VBox spacing="12.0">
                    <padding><Insets bottom="18.0" left="16.0" right="16.0" top="16.0" /></padding>
                    <Label styleClass="section-title" text="Mốc học kỳ và nhập điểm" />
                    <Label styleClass="section-subtitle"
                           text="Học kỳ chỉ dùng để phân loại kết quả. Sinh viên nhập điểm từ ngày kết thúc học kỳ đến hạn chót."
                           wrapText="true" />
                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <TextField fx:id="txtTermCode" promptText="Mã học kỳ, ví dụ 2026-1" />
                        <Button onAction="#onLoadTermSettings" text="Tải cấu hình" />
                    </HBox>
                    <GridPane hgap="12.0" vgap="10.0">
                        <columnConstraints>
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0" />
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0" />
                        </columnConstraints>
                        <DatePicker fx:id="dpSemesterEnd" promptText="Ngày kết thúc học kỳ"
                                    maxWidth="Infinity" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                        <TextField fx:id="txtGradeEntryDeadline" promptText="Hạn chót nhập điểm (yyyy-MM-dd HH:mm)"
                                   GridPane.columnIndex="1" GridPane.rowIndex="0" />
                    </GridPane>
                    <HBox alignment="CENTER_RIGHT" spacing="8.0">
                        <Button onAction="#onSaveTermSettings" styleClass="primary-button"
                                text="Lưu mốc điểm" />
                    </HBox>
                    <Label text="Lịch đăng ký được quản lý riêng theo khoa/ngành trong tab “Đăng ký &amp; chương trình”." />
                </VBox>
                </content>
                </ScrollPane>
            </Tab>
            <Tab text="Đăng ký &amp; chương trình">
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="ALWAYS">
                <content>
                <VBox spacing="12.0">
                    <padding><Insets bottom="18.0" left="16.0" right="16.0" top="16.0" /></padding>
                    <Label styleClass="section-title" text="Đợt đăng ký theo khoa/ngành và chương trình đào tạo" />
                    <Label styleClass="section-subtitle"
                           text="Khai báo chương trình trước khi mở đợt; hệ thống khóa chỉnh sửa môn khi đợt đang mở. Mã khoa/ngành phải khớp với Users.Khoa."
                           wrapText="true" />
                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <ComboBox fx:id="cmbProgramMajor" promptText="Chọn khoa/ngành" maxWidth="Infinity"
                                  HBox.hgrow="ALWAYS" />
                        <Button onAction="#onLoadMajorRegistration" text="Tải dữ liệu" />
                    </HBox>
                    <GridPane hgap="12.0" vgap="10.0">
                        <columnConstraints>
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0" />
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0" />
                        </columnConstraints>
                        <VBox spacing="4.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <Label text="Ngày bắt đầu · mở lúc 12:00 trưa" />
                            <DatePicker fx:id="dpMajorRegistrationOpensOn" promptText="Chọn ngày bắt đầu"
                                        maxWidth="Infinity" />
                        </VBox>
                        <VBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <Label text="Ngày kết thúc · đóng lúc 12:00 trưa" />
                            <DatePicker fx:id="dpMajorRegistrationClosesOn" promptText="Chọn ngày kết thúc"
                                        maxWidth="Infinity" />
                        </VBox>
                    </GridPane>
                    <HBox alignment="CENTER_RIGHT" spacing="8.0">
                        <Button onAction="#onSaveMajorRegistration" styleClass="primary-button"
                                text="Lưu lịch đăng ký" />
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <Button onAction="#onAddAllProgramCourses" styleClass="primary-button"
                                text="Thêm tất cả môn đang hoạt động vào chương trình" />
                        <Button onAction="#onRemoveProgramCourse" text="Gỡ môn đã chọn" />
                    </HBox>
                    <TableView fx:id="tblProgramCourses" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colProgramCourseCode" text="Mã môn" prefWidth="180.0" />
                            <TableColumn fx:id="colProgramCourseName" text="Tên môn" prefWidth="500.0" />
                        </columns>
                    </TableView>
                </VBox>
                </content>
                </ScrollPane>
            </Tab>
        </tabs>
    </TabPane>
</VBox>
