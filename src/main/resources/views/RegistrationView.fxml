<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane minHeight="650.0" minWidth="1000.0" prefHeight="760.0" prefWidth="1200.0"
            styleClass="dashboard-page" stylesheets="@../css/app.css"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controllers.RegistrationController">
    <center>
        <VBox spacing="9.0" styleClass="registration-content">
            <padding><Insets bottom="12.0" left="24.0" right="24.0" top="12.0" /></padding>
            <HBox alignment="CENTER_LEFT" spacing="12.0">
                <VBox spacing="3.0" HBox.hgrow="ALWAYS">
                    <Label styleClass="registration-title" text="Đăng ký tín chỉ" />
                    <Label styleClass="registration-subtitle"
                           text="Danh sách lớp thuộc chương trình đào tạo và đợt đăng ký của khoa/ngành." />
                </VBox>
                <Button onAction="#onRefresh" styleClass="registration-refresh-button" text="↻  Tải lại" />
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <TextField fx:id="txtSearch" HBox.hgrow="ALWAYS"
                           promptText="Tìm theo mã, tên học phần, lớp hoặc giảng viên..."
                           styleClass="form-field registration-search" />
                <Button fx:id="btnConfirm" disable="true" onAction="#onConfirmRegistration"
                        styleClass="login-button registration-confirm" text="Đăng ký môn đã chọn" />
            </HBox>

            <VBox spacing="6.0" styleClass="registration-card" VBox.vgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT">
                    <VBox spacing="2.0">
                        <Label styleClass="section-title" text="Các môn học đang mở" />
                        <Label styleClass="section-subtitle"
                               text="Chọn một lớp để đăng ký. Lịch học và giảng viên hiển thị cùng nhau." />
                    </VBox>
                </HBox>
                <TableView fx:id="tblClasses" minHeight="150.0" prefHeight="260.0"
                           styleClass="registration-table" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colCourseName" prefWidth="300.0" text="TÊN HỌC PHẦN" />
                        <TableColumn fx:id="colCourseCode" prefWidth="190.0" text="MÃ HỌC PHẦN · LỚP" />
                        <TableColumn fx:id="colCredits" prefWidth="95.0" text="TÍN CHỈ" />
                        <TableColumn fx:id="colClassCapacity" prefWidth="110.0" text="SĨ SỐ" />
                        <TableColumn fx:id="colClassSchedule" prefWidth="460.0" text="LỊCH HỌC · GIẢNG VIÊN" />
                    </columns>
                </TableView>
                <Label fx:id="lblEmpty" managed="false" visible="false" styleClass="registration-empty"
                       text="Hiện chưa có lớp học nào được mở." wrapText="true" />
                <Label styleClass="registration-action-copy"
                       text="Mỗi học kỳ đăng ký từ 11 đến 26 tín chỉ. Có thể đăng ký nhiều đợt cho đến khi chốt."
                       wrapText="true" />
            </VBox>

            <VBox spacing="6.0" styleClass="registration-card">
                <HBox alignment="CENTER_LEFT">
                    <VBox spacing="2.0">
                        <Label styleClass="section-title" text="Các lớp đã đăng ký" />
                        <Label styleClass="section-subtitle" text="Lớp đang học và trạng thái chốt đăng ký." />
                    </VBox>
                </HBox>
                <TableView fx:id="tblRegistered" prefHeight="115.0"
                           styleClass="registration-table registered-table">
                    <columns>
                        <TableColumn fx:id="colRegisteredClass" prefWidth="125.0" text="MÃ LỚP" />
                        <TableColumn fx:id="colRegisteredCourse" prefWidth="260.0" text="HỌC PHẦN" />
                        <TableColumn fx:id="colRegisteredSemester" prefWidth="110.0" text="HỌC KỲ" />
                        <TableColumn fx:id="colRegisteredSchedule" prefWidth="300.0" text="LỊCH HỌC" />
                        <TableColumn fx:id="colRegisteredCredits" prefWidth="90.0" text="TÍN CHỈ" />
                        <TableColumn fx:id="colRegisteredStatus" prefWidth="150.0" text="TRẠNG THÁI" />
                    </columns>
                </TableView>
                <HBox alignment="CENTER_RIGHT" spacing="8.0">
                    <ComboBox fx:id="cmbLockSemester" promptText="Chọn học kỳ để chốt" />
                    <Button fx:id="btnLockSemester" disable="true" onAction="#onLockSemester"
                            styleClass="login-button registration-confirm" text="Chốt đăng ký" />
                    <Button fx:id="btnCancelRegistration" disable="true" onAction="#onCancelRegistration"
                            styleClass="registration-cancel-button" text="Hủy lớp đã chọn" />
                </HBox>
            </VBox>
            <Label fx:id="lblStatus" managed="false" visible="false"
                   styleClass="registration-message" text="Thông báo trạng thái" wrapText="true" />
        </VBox>
    </center>
</BorderPane>
