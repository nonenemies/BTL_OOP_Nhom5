<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane minHeight="500.0" minWidth="700.0" styleClass="dashboard-page"
            stylesheets="@../css/app.css"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controllers.DashBoardController">
    <center>
        <ScrollPane fitToWidth="true" styleClass="dashboard-scroll">
            <content>
                <VBox spacing="22.0" styleClass="dashboard-content">
                    <padding>
                        <Insets bottom="32.0" left="34.0" right="34.0" top="28.0" />
                    </padding>
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="dashboard-topbar">
                            <VBox spacing="5.0">
                                <Label styleClass="topbar-kicker" text="TỔNG QUAN TÀI KHOẢN" />
                                <Label styleClass="topbar-title" text="Tổng quan" />
                            </VBox>
                            <Region HBox.hgrow="ALWAYS" />
                            <VBox alignment="CENTER_RIGHT" spacing="4.0">
                                <Label fx:id="lblWelcome" styleClass="student-name" text="Xin chào" />
                                <Label fx:id="lblRoleBadge" styleClass="student-id" text="" />
                            </VBox>
                            <Button onAction="#onRefresh" styleClass="registration-refresh-button"
                                    text="Làm mới" />
                        </HBox>

                        <VBox spacing="8.0" styleClass="welcome-banner">
                            <Label styleClass="banner-eyebrow" text="DỮ LIỆU THỰC TẾ" />
                            <Label fx:id="lblRoleSummary" styleClass="banner-title"
                                   text="Đang tải thông tin tổng quan" wrapText="true" />
                            <Label fx:id="lblAccountStatus" styleClass="banner-description"
                                   text="" wrapText="true" />
                        </VBox>

                        <HBox fx:id="summaryCards" spacing="14.0" styleClass="stats-row" />

                        <HBox spacing="18.0" styleClass="dashboard-sections">
                            <VBox HBox.hgrow="ALWAYS" spacing="12.0"
                                  styleClass="dashboard-panel profile-panel">
                                <VBox spacing="4.0">
                                    <Label fx:id="lblProfileTitle" styleClass="section-title"
                                           text="Thông tin tài khoản" />
                                    <Label styleClass="section-subtitle" text="Hồ sơ đang đăng nhập" />
                                </VBox>
                                <VBox fx:id="profileDetails" spacing="11.0" />
                            </VBox>

                            <VBox HBox.hgrow="ALWAYS" spacing="12.0"
                                  styleClass="dashboard-panel activity-panel">
                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <VBox spacing="4.0">
                                        <Label fx:id="lblActivityTitle" styleClass="section-title"
                                               text="Hoạt động" />
                                        <Label fx:id="lblActivitySubtitle" styleClass="section-subtitle"
                                               text="" wrapText="true" />
                                    </VBox>
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Button fx:id="btnTimetable" onAction="#onOpenTimetable"
                                            styleClass="text-button" text="Thời khóa biểu  →" />
                                </HBox>
                                <VBox fx:id="activityList" spacing="9.0" />
                            </VBox>
                        </HBox>

                        <Label fx:id="lblStatus" managed="false" styleClass="teacher-status-info"
                               text="" visible="false" wrapText="true" />
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
